{
  // Declaration-only emit for the framework-agnostic core (the `.` export).
  // tsup emits the JS bundle (dist/index.js); this emits a per-file .d.ts tree
  // mirroring src/core/** because tsc (unlike rollup-plugin-dts) can parse the
  // committed Paraglide ES2022 string-literal exports. That per-file tree is
  // an INTERMEDIATE artifact only: scripts/build.mjs immediately bundles it
  // (via rollup + rollup-plugin-dts, which - unlike tsup's dts:true - can be
  // pointed at already-emitted .d.ts input, sidestepping the Paraglide source
  // parsing problem) into self-contained per-entry .d.ts files that structurally
  // match tsup's single-file-per-entry JS output, then deletes the per-file tree.
  // declarationMap is off because those maps would describe the intermediate
  // tree, not the bundled files that actually ship.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "src/core",
    "outDir": "dist"
  },
  "include": ["src/core/**/*"],
  "exclude": ["node_modules", "dist", "examples", "tests", "**/*.test.ts"]
}
