{
  // Deno-native server target ("./server" export) - real JS + .d.ts emit via
  // plain tsc, no tsup/bundler. Each source file's .js/.d.ts pair mirrors its
  // own path directly (src/server/foo.ts -> dist/server/foo.js + .d.ts), so
  // there's no bundler-vs-declaration path mismatch to work around here.
  // See docs/MULTI_FRAMEWORK_PACKAGING_PLAN.md - src/server is deliberately
  // outside src/core/ and not part of the "." barrel.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src/server",
    "outDir": "dist/server",
    // Override the base config's dev-time source alias: resolving
    // @thepia/flows-auth/telemetry to src/core/telemetry.ts would pull that
    // file (and its own src/core/telemetry/** dependencies) into THIS
    // project, which tsc rejects since they fall outside rootDir. Point it
    // instead at core's already-emitted declaration in the build's scratch
    // directory (scripts/build.mjs runs core's tsup+tsc pass into
    // dist.build/ before this server pass, then atomically swaps
    // dist.build/ -> dist/ only as its very last step) - resolving against
    // the live `dist/` here would only work by accident, on a machine that
    // happens to have a stale dist/ from a prior build; a clean checkout
    // (CI) has no dist/ at all yet at this point in the pipeline.
    "paths": {
      "@thepia/flows-auth/telemetry": ["./dist.build/telemetry.d.ts"]
    }
  },
  "include": ["src/server/**/*"],
  "exclude": ["node_modules", "dist", "examples", "tests", "**/*.test.ts"]
}
